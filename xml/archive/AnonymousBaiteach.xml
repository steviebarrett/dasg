  <items>
    <item><headword id="d0e14" type="heading" level="h1">1. Na togalaichean: sobhal, bàthach is mar sin, agus ainm gach pàirt dhiubh</headword></item>
    <item>
      <headword id="d0e19">airidh</headword>
      <description>hen roost.</description>
    </item>
    <item>
      <headword id="d0e28">atha</headword>
      <description>equiv. of ‘sobhal’.</description>
    </item>
    <item>
      <headword id="d0e37">àth</headword>
      <description>kiln.</description>
    </item>
    <item>
      <headword id="d0e46">aol</headword>
      <description>lime.</description>
    </item>
