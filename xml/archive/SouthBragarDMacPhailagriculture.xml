    <item>
      <headword id="d0e653">toirt an eich as a cairt</headword>
      <description>releasing horse from cart.</description>
    </item>
    <item>
      <headword id="d0e662">tùmadh na cairt</headword>
      <description>emptying the cart.</description>
    </item>
    <item><headword id="d0e670" type="heading" level="h1">4. The plough</headword></item>
