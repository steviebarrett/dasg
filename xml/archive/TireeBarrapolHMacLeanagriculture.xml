    </item>
    <item>
      <headword id="d0e800">osan an t-suic</headword>
      <description>where the sock fits on to plough.</description>
    </item>
    <item>
      <headword id="d0e809">coltaire (m), coltairean (pl)</headword>
      <description>coulter.</description>
    </item>
    <item>
      <headword id="d0e818">spàg (f), spàgan (pl)</headword>
