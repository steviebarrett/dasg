      <description>marking.</description>
    </item>
    <item>
      <headword id="d0e40">a’ rusgadh</headword>
      <description>stripping.</description>
    </item>
    <item>
      <headword id="d0e49">a’ glanadh a’ bhaic</headword>
      <description>stripping.</description>
    </item>
    <item>
      <headword id="d0e58">a’ barradh</headword>
      <description>stripping.</description>
    </item>
    <item>
      <headword id="d0e67">poll-mona</headword>
      <description>peat area.</description>
    </item>
    <item>
      <headword id="d0e76">blar-mona</headword>
      <description>peat area.</description>
    </item>
    <item>
      <headword id="d0e85">bac</headword>
