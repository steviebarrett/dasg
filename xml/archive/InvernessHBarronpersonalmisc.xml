    </item>
    <item>
      <headword id="idp121657056">tarbh nathair neimh</headword>
      <description>dragonfly.</description>
    </item>
    <item>
      <headword id="idp121658568">tatair</headword>
      <description>sharp warning word. “Cum tatair air a’ ghille.”</description>
    </item>
    <item>
      <headword id="idp121660224">tathaich</headword>
      <description>voice with sense of foreboding.</description>
    </item>
    <item>
      <headword id="idp121661736">tathaich-tilgeil</headword>
