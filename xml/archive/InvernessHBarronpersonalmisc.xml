    </item>
    <item>
      <headword id="idp121645896">starsaig</headword>
      <description>doorstep.</description>
    </item>
    <item>
      <headword id="idp121647408">strotaich</headword>
      <description>sneezing.</description>
    </item>
    <item>
      <headword id="idp121648920">soidh</headword>
      <description>hay.</description>
    </item>
    <item>
      <headword id="idp121650432">tadhall</headword>
      <description>wits. (pron. [tʹəuəl])</description>
    </item>
    <item>
      <headword id="idp121652232">tà</headword>
      <description>yet. “Tà chan eil”, etc.</description>
    </item>
    <item>
      <headword id="idp121653888">taois</headword>
