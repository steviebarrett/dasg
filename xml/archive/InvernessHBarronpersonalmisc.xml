    </item>
    <item>
      <headword id="idp115143976">laigeard</headword>
      <description>a slap.</description>
    </item>
    <item>
      <headword id="idp117066760">lonaig</headword>
      <description>avenue.</description>
    </item>
    <item>
      <headword id="idp117067480">long</headword>
      <description>ship (is pron. ‘low’).</description>
    </item>
    <item>
      <headword id="idp117035944">meag</headword>
      <description>sign of life. (T.G.S.I., 29)</description>
    </item>
    <item>
      <headword id="idp117029608">mìochadaidh</headword>
      <description>mean.</description>
    </item>
    <item>
      <headword id="idp117034720">oi (aghaidh)</headword>
      <description>Gabh d’ oi – take care. Nam oi – against me.</description>
    </item>
    <item>
      <headword id="idp117034000">pat, patan</headword>
      <description>blobs, blisters.</description>
    </item>
    <item>
      <headword id="idp117042352">poitear</headword>
      <description>joker.</description>
    </item>
    <item>
      <headword id="idp117045520">gineil</headword>
      <description>joker.</description>
    </item>
    <item>
      <headword id="idp2819928">ceann an àigh</headword>
      <description>joker.</description>
    </item>
    <item>
      <headword id="idp2780040">plugh</headword>
      <description>sense (‘u’ as in Eng. ‘but’).</description>
    </item>
    <item>
      <headword id="idp121618176">prabach</headword>
      <description>talkative in a silly way.</description>
    </item>
    <item>
      <headword id="idp121619688">praban</headword>
      <description>insignificant fellow.</description>
    </item>
    <item>
      <headword id="idp121621200">proitseach</headword>
      <description>boy about 7-10.</description>
    </item>
    <item>
      <headword id="idp121622712">roilean</headword>
