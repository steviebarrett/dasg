    </item>
    <item>
      <headword id="idp121624368">sàilidh</headword>
      <description>heel, ball size of a heel.</description>
    </item>
    <item>
      <headword id="idp121625880">sealbh</headword>
      <description>Gu shealladh sealbh ort. – Heaven help you.</description>
    </item>
    <item>
      <headword id="idp121627392">searcan</headword>
      <description>teazle, burr.</description>
    </item>
    <item>
      <headword id="idp121628904">seolaid</headword>
