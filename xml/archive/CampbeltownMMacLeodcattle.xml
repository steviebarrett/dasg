      <description>up to 3 years of age.</description>
    </item>
    <item>
      <headword id="d0e66">agh</headword>
      <description>[cow] bearing the first calf.</description>
    </item>
    <item>
      <headword id="d0e75">damh</headword>
      <description>castrated bull or bullock.</description>
    </item>
    <item>
      <headword id="d0e84">mart-làmhaidh</headword>
