      <headword id="idp161248936">geadhachail</headword>
      <description>odds and ends.</description>
    </item>
    <item>
      <headword id="idp161250448">ròlaist</headword>
      <description>romance.</description>
    </item>
    <item>
      <headword id="idp161251960">brothnach air shearrach</headword>
      <description>helter-skelter.</description>
    </item>
    <item>
      <headword id="idp161253472">cròdhadh</headword>
      <description>housing of cattle in winter.</description>
    </item>
    <item>
      <headword id="idp161254984">ludanda</headword>
      <description>clumsy.</description>
    </item>
    <item>
      <headword id="idp161256496">monaiseach</headword>
      <description>diffident.</description>
