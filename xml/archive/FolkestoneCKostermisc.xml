  <title>Measgaichte / Miscellaneous</title>
  <fieldworker>[self]</fieldworker>
  <note>[NOTES: the informant explains in the letter attached to the word-list that it contains ‘some unusual words I heard from my parents – my mother being a native of Applecross (…) A few of these words I heard on holiday in Melness last summer.’]</note>
  <informant>
    <nameEnglish>Catherine Koster</nameEnglish>
    <origin>Applecross [mother]</origin>
  </informant>
  <location>Kent, Folkestone</location>
  <items>
    <item>
