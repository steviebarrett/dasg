    <item><headword id="d0e248" type="heading" level="h1">12. Ainmean a chleachdar ri earrainn fearainn</headword></item>
    <item>
      <headword id="idp2534664">lòt</headword>
      <description>croft.</description>
    </item>
    <item>
      <headword id="idp2401000">iomair</headword>
      <description>separate fields of corn or potatoes.</description>
    </item>
